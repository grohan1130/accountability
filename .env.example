# Copy to .env and adjust: `cp .env.example .env`
# NOTE: POSTGRES_* and PGADMIN_DEFAULT_* only apply on first startup (empty volumes).
#       To apply changes later: docker compose down -v (this deletes local data).

# --- Postgres ---
POSTGRES_USER=streaks
POSTGRES_DB=streaks_local_db
POSTGRES_PASSWORD=changeme
# Host port on your machine. Change if 5432 is already in use.
POSTGRES_DB_PORT=5432

# --- pgAdmin (web UI at http://localhost:<PGADMIN_PORT>) ---
# Must look like a real email address; pgAdmin rejects some formats (e.g. .local).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050
